    if i.KeyCode == Enum.KeyCode.Z and boostE then doB() end
    if i.KeyCode == Enum.KeyCode.Space and Movement.SuperJump then
        Movement.ExecuteSuperJump()
    end
end)

local function startV4()
    if V4Con then V4Con:Disconnect() end
    V4Con = RS.Heartbeat:Connect(function()
        if not autoV4 then V4Con:Disconnect(); V4Con = nil return end
        pcall(function()
            local c = lp.Character
            if c and c:FindFirstChild'Awakening' then
                c.Awakening.RemoteFunction:InvokeServer(true)
            elseif lp.Backpack:FindFirstChild'Awakening' then
                lp.Backpack.Awakening.RemoteFunction:InvokeServer(true)
            end
        end)
    end)
end

RS.RenderStepped:Connect(function(deltaTime)
    if InfiniteZoom then
        lp.CameraMaxZoomDistance = math.huge
    else
        lp.CameraMaxZoomDistance = savedZoom
    end
    
    if ncl and lp.Character then
        for _, p in next, lp.Character:GetDescendants() do
            if p:IsA'BasePart' then p.CanCollide = false end
        end
    end
    
    if walkW and workspace:FindFirstChild'Map' and workspace.Map:FindFirstChild'WaterBase-Plane' then
        workspace.Map['WaterBase-Plane'].Size = Vector3.new(1000, 112, 1000)
    end
    
    Movement.ApplySpeedBoost(deltaTime)
    if Movement.WaterPlatform then
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if hrp then Movement.WaterPlatform.Position = Vector3.new(hrp.Position.X, -0.5, hrp.Position.Z) end
    end
    if Movement.LavaPlatform then
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if hrp then Movement.LavaPlatform.Position = Vector3.new(hrp.Position.X, 9.5, hrp.Position.Z) end
    end
    if Movement.NoClip and lp.Character then
        for _, p in next, lp.Character:GetDescendants() do
            if p:IsA'BasePart' then p.CanCollide = false end
        end
    end
    
    if FA then pcall(function()
        local c = lp.Character
        local my = c and c:FindFirstChild'HumanoidRootPart'
        if not my then return end
        local t = {}
        for _, pl in next, P:GetPlayers() do
            if pl ~= lp and pl.Character then
                local hr = pl.Character:FindFirstChild'HumanoidRootPart'
                local h = pl.Character:FindFirstChild'Humanoid'
                if hr and h and h.Health > 0 and (hr.Position - my.Position).Magnitude <= FAr then
                    table.insert(t, pl.Character)
                end
            end
        end
        local E = workspace:FindFirstChild'Enemies'
        if E then
            for _, n in next, E:GetChildren() do
                local hr = n:FindFirstChild'HumanoidRootPart'
                local h = n:FindFirstChild'Humanoid'
                if hr and h and h.Health > 0 and (hr.Position - my.Position).Magnitude <= FAr then
                    table.insert(t, n)
                end
            end
        end
        if #t > 0 then
            local at = {}
            for _, ch in next, t do
                local hd = ch:FindFirstChild'Head'
                if hd then table.insert(at, {ch, hd}) end
            end
            if #at > 0 then
                RA:FireServer(0)
                RH:FireServer(at[1][2], at)
            end
        end
    end) end
    
    if DG then pcall(function()
        local c = lp.Character
        local tool = c and c:FindFirstChildOfClass'Tool'
        if tool and tool.ToolTip == 'Gun' then
            local tar = DGT()
            if tar then
                local cd, cnt = NV()
                if cd ~= 0 then
                    if V2 then V2:FireServer(cd, cnt) end
                    if SGE then SGE:FireServer(tar.Position, {tar}) end
                end
                for i = 2, DGsp do
                    task.wait()
                    cd, cnt = NV()
                    if cd ~= 0 then
                        if V2 then V2:FireServer(cd, cnt) end
                        if SGE then SGE:FireServer(tar.Position, {tar}) end
                    end
                end
                tool:SetAttribute('LocalOverheat', 0)
                tool:SetAttribute('LocalTotalShots', (tool:GetAttribute('LocalTotalShots') or 0) + DGsp)
            end
        end
    end) end
end)

RS.Heartbeat:Connect(function()
    if not BypassTP then return end
    pcall(function()
        local c = lp.Character
        local hrp = c and c:FindFirstChild'HumanoidRootPart'
        if not hrp then return end
        local closest, shortest = nil, math.huge
        local folder = workspace:FindFirstChild'Enemies' or workspace
        for _, obj in ipairs(folder:GetChildren()) do
            if obj:IsA('Model') and obj ~= c then
                local nameL = string.lower(obj.Name)
                if nameL == "blank buddy" or nameL == "sombra" then continue end
                local hum = obj:FindFirstChildOfClass'Humanoid'
                local root = obj:FindFirstChild'HumanoidRootPart' or obj:FindFirstChild'Head'
                if hum and hum.Health > 0 and root then
                    local d = (root.Position - hrp.Position).Magnitude
                    if string.find(nameL, "gas knight") or string.find(nameL, "kitsune") then d = d - 1000 end
                    if d < shortest then shortest = d; closest = obj end
                end
            end
        end
        if closest then
            local root = closest:FindFirstChild'HumanoidRootPart' or closest:FindFirstChild'Head'
            if root then hrp.CFrame = root.CFrame * CFrame.new(0, AttackHeight, 0) end
        end
    end)
end)

local mt = getrawmetatable(game)
local oldIdx = mt.__index
setreadonly(mt, false)
mt.__index = newcclosure(function(self, k)
    if not checkcaller() and self == m and (k == 'Hit' or k == 'Target') then
        if SoruAim then
            local cl, sD = nil, math.huge
            local r = lp.Character and lp.Character:FindFirstChild'HumanoidRootPart'
            if r then
                for _, pl in next, P:GetPlayers() do
                    if pl ~= lp and pl.Character and pl.Character:FindFirstChild'HumanoidRootPart' then
                        local hr = pl.Character.HumanoidRootPart
                        local d = (r.Position - hr.Position).Magnitude
                        if d < sD and d <= soruR then sD = d; cl = hr end
                    end
                end
                local E = workspace:FindFirstChild'Enemies'
                if E then
                    for _, n in next, E:GetChildren() do
                        local hr = n:FindFirstChild'HumanoidRootPart'
                        local h = n:FindFirstChild'Humanoid'
                        if hr and h and h.Health > 0 then
                            local d = (r.Position - hr.Position).Magnitude
                            if d < sD and d <= soruR then sD = d; cl = hr end
                        end
                    end
                end
            end
            if cl then
                if k == 'Hit' then return CFrame.new(cl.Position) end
                if k == 'Target' then return cl end
            end
        end
    end
    return oldIdx(self, k)
end)
setreadonly(mt, true)

