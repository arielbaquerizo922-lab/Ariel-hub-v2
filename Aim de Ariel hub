                    end
                    local best = SelectBestTarget(targets, TargetPriority)
                    if best then
                        local pos = best.HRP.Position
                        if PredictionEnabled then
                            local v = best.HRP.AssemblyLinearVelocity
                            pos += v * PredictionAmount
                        end
                        return best.HRP, pos, Vector3.new(), best
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
end

