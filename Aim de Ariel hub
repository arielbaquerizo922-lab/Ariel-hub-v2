-- Funciones auxiliares
local function WorldToScreen(point)
    local pos, visible = Camera:WorldToViewportPoint(point)
    return Vector2.new(pos.X, pos.Y), visible
end

local function GetAngleBetween(v1, v2)
    return math.acos(math.clamp(v1:Dot(v2) / math.max(v1.Magnitude * v2.Magnitude, 0.001), -1, 1))
end

local function GetToolCategory(tool)
    if not tool then return "Melee" end
    local name = string.lower(tool.Name)
    local tip = tool.ToolTip or ""
    if tip == "Gun" or name:find("gun") or name:find("rifle") or name:find("bow") then return "Gun" end
    if tip == "Blox Fruit" or name:find("fruit") then return "Fruit" end
    if tip == "Sword" then return "Sword" end
    return "Melee"
end

local function IsKeyBlacklisted(key)
    local cat = currentToolCategory or "Melee"
    return BlacklistedKeys[cat] and BlacklistedKeys[cat][key] == true
end

-- Obtener jugadores objetivo
local function GetValidPlayers()
    local valid = {}
    local myChar = player.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return valid end
    local myPos = myChar.HumanoidRootPart.Position
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        if p ~= player and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - myPos).Magnitude
                if dist <= maxRange then
                    valid[#valid+1] = {Player = p, HRP = hrp, Distance = dist}
                end
            end
        end
    end
    return valid
end

-- Obtener NPCs objetivo
local function GetValidNPCs(range)
    local valid = {}
    range = range or maxRange
    local myChar = player.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return valid end
    local myPos = myChar.HumanoidRootPart.Position
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, npc in ipairs(enemies:GetChildren()) do
            local hrp = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
            local hum = npc:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - myPos).Magnitude
                if dist <= range then
                    valid[#valid+1] = {NPC = npc, HRP = hrp, Distance = dist}
                end
            end
        end
    end
    return valid
end

-- Filtrar por FOV
local function FilterByFOV(targets, fovRadius, mode)
    local filtered = {}
    local camCF = Camera.CFrame
    local camPos = camCF.Position
    local camDir = camCF.LookVector
    local scrCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    
    for _, t in ipairs(targets) do
        local tPos = t.HRP.Position
        local scrPos, vis = WorldToScreen(tPos)
        if vis then
            if mode == "V1" then
                local dist = (scrPos - scrCenter).Magnitude
                if dist <= fovRadius then filtered[#filtered+1] = t end
            else
                local dir = (tPos - camPos).Unit
                local angle = GetAngleBetween(camDir, dir)
                if angle <= math.rad(fovRadius/3) then filtered[#filtered+1] = t end
            end
        end
    end
    return filtered
end

-- Seleccionar mejor objetivo
local function SelectBestTarget(targets, priority)
    if #targets == 0 then return nil end
    table.sort(targets, function(a, b)
        if priority == "Nearest" then return a.Distance < b.Distance end
        if priority == "LowHP" then
            local ah = a.Player and a.Player.Character and a.Player.Character:FindFirstChild("Humanoid")
            local bh = b.Player and b.Player.Character and b.Player.Character:FindFirstChild("Humanoid")
            ah = ah and ah.Health or math.huge
            bh = bh and bh.Health or math.huge
            return ah < bh
        end
        return a.Distance < b.Distance
    end)
    return targets[1]
end

