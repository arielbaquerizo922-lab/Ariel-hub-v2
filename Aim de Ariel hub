    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithIgnoreListAsync" then
            if SilentAimPlayersEnabled or SilentAimNPCsEnabled then
                local ray = ...
                if ray then
                    local targets = {}
                    if SilentAimPlayersEnabled then
                        for _, v in ipairs(FilterByFOV(GetValidPlayers(), FOVRadius, FOVMode)) do targets[#targets+1] = v end
                    end
                    if SilentAimNPCsEnabled then
