local ambientPresets = {
    Rain = {Ambient=Color3.fromRGB(90,100,120),Outdoor=Color3.fromRGB(70,80,100),Brightness=1},
    Night = {Ambient=Color3.fromRGB(40,40,60),Outdoor=Color3.fromRGB(30,30,50),Brightness=0.5},
    Day = {Ambient=Color3.fromRGB(140,140,140),Outdoor=Color3.fromRGB(128,128,128),Brightness=2},
    Foggy = {Ambient=Color3.fromRGB(100,100,110),Outdoor=Color3.fromRGB(90,90,100),Brightness=1.2},
}
local skyInst = nil

local function processObject(inst)
    if inst:IsA("Beam") or inst:IsA("Trail") then
        if not noGfxModifiedObjects[inst] then noGfxModifiedObjects[inst]={Texture=inst.Texture}; inst.Texture="rbxassetid://84308155859778" end
    elseif inst:IsA("ParticleEmitter") then
        if not noGfxModifiedObjects[inst] then noGfxModifiedObjects[inst]={Texture=inst.Texture,Enabled=inst.Enabled}; inst.Texture=""; inst.Enabled=false end
    end
end
local function restoreNoGfx()
    for obj,data in pairs(noGfxModifiedObjects) do pcall(function() if data.Texture then obj.Texture=data.Texture end; if data.Enabled~=nil then obj.Enabled=data.Enabled end end) end
    noGfxModifiedObjects={}
    if noGfxConnections.Desc then noGfxConnections.Desc:Disconnect() end
end
local function setNoGfxMode(mode)
    if mode==noGfxMode then return end
    noGfxMode=mode; Config.NoGfxMode=mode
    restoreNoGfx()
    if mode=="V1" or mode=="V2" then
        task.spawn(function() for _,inst in ipairs(Workspace:GetDescendants()) do processObject(inst) end end)
        noGfxConnections.Desc = Workspace.DescendantAdded:Connect(processObject)
    end
end
local function applySky()
    if skyInst then skyInst:Destroy() skyInst=nil end
    if not Config.SkyEnabled then return end
    local d = skies[Config.SkyType]
    if d then skyInst=Instance.new("Sky"); for k,v in pairs(d) do skyInst[k]=v end; skyInst.Parent=Lighting end
end
local function applyAmbient()
    if not Config.AmbientEnabled then Lighting.Ambient=Color3.fromRGB(70,70,70); Lighting.OutdoorAmbient=Color3.fromRGB(128,128,128); return end
    local p = ambientPresets[Config.AmbientType] or ambientPresets.Rain
    Lighting.Ambient=p.Ambient; Lighting.OutdoorAmbient=p.Outdoor; Lighting.Brightness=p.Brightness
end
local function applyMinecraft(on)
    Config.MinecraftTex=on
    pcall(function()
        if on then Lighting.GlobalShadows=false; Lighting.Brightness=2.5; Lighting.Ambient=Color3.fromRGB(140,140,140)
        else Lighting.GlobalShadows=true; Lighting.Brightness=2 end
    end)
end
local FastFlagSets = {
    [1]={{"DFIntTaskSchedulerTargetFps","9999"},{"FFlagTaskSchedulerLimitTargetFpsTo2402","False"},{"DFIntTextureQualityOverride","1"},{"FFlagDisablePostFx","True"},{"FIntRenderShadowIntensity","0"}},
    [2]={{"DFIntConnectionMTUSize","1492"},{"DFIntMaxFrameBufferSize","4"},{"DFIntS2PhysicsSenderRate","15"}},
    [3]={{"FFlagHandleAltEnterFullscreenManually","False"},{"FFlagDebugSkyGray","True"},{"FFlagDisableNewLightAttenuation","True"}},
}
local function InjectFastFlags(setId)
    setId=setId or 1; local list=FastFlagSets[setId] or FastFlagSets[1]; local ok=0
    for _,pair in ipairs(list) do
        pcall(function() if setfflag then setfflag(pair[1],pair[2]); ok=ok+1 end end)
    end
    pcall(function() if setfpscap then setfpscap(999) end end)
    return ok
end

