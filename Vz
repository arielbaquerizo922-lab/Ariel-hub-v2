local BypassTpConn = nil
local function StartBypassTpNpc()
    if BypassTpConn then return end
    BypassTpConn = task.spawn(function()
        while Config.BypassTpNpc do
            task.wait(0.15)
            pcall(function()
                local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                local enemies = Workspace:FindFirstChild("Enemies")
                if not hrp or not enemies then return end
                local list = {}
                for _, npc in ipairs(enemies:GetChildren()) do
                    if npc:IsA("Model") then
                        local eRoot = npc:FindFirstChild("HumanoidRootPart")
                        local eHum = npc:FindFirstChildOfClass("Humanoid")
                        if eRoot and eHum and eHum.Health>0 then
                            local d = (eRoot.Position - hrp.Position).Magnitude
                            if d <= Config.BypassTpRange then table.insert(list,{root=eRoot,dist=d,model=npc}) end
                        end
                    end
                end
                if #list==0 then return end
                table.sort(list,function(a,b)return a.dist<b.dist end)
                if Config.BypassTpMode == "Nearest" then
                    local t = list[1].root
                    local y = Config.BypassTpAbove and Config.BypassTpHeight or 3
                    hrp.CFrame = CFrame.new(t.Position + Vector3.new(0,y,0))
                elseif Config.BypassTpMode == "All in Range" then
                    for _,item in ipairs(list) do
                        pcall(function()
                            item.root.CFrame = hrp.CFrame * CFrame.new(0,-5,-3)
                            item.root.CanCollide = false
                        end)
                    end
                elseif Config.BypassTpMode == "Bring to Me" then
                    for _,item in ipairs(list) do
                        pcall(function() item.root.CFrame = CFrame.new(hrp.Position + Vector3.new(0,-8,0)) end)
                    end
                end
            end)
        end
        BypassTpConn = nil
    end)
end
local function StopBypassTpNpc() Config.BypassTpNpc=false; if BypassTpConn then task.cancel(BypassTpConn) BypassTpConn=nil end end

