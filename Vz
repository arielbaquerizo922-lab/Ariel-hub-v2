-- 👤 SISTEMA DE TELETRANSPORTE A JUGADORES
-- ──────────────────────────────────────────────
local TpPlayerConn = nil
local function GetClosestPlayerHRP()
    local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    if Config.SelectedTrackPlayer ~= "Nearest" then
        local p = Players:FindFirstChild(Config.SelectedTrackPlayer)
        if p and p.Character then return p.Character:FindFirstChild("HumanoidRootPart") end
    end
    local best, bd = nil, math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=lp and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health>0 then
                local d = (r.Position - myHRP.Position).Magnitude
                if d<bd then bd=d; best=r end
            end
        end
    end
    return best
end
local function StartTpToPlayer()
    if TpPlayerConn then return end
    TpPlayerConn = task.spawn(function()
        while Config.TpToPlayer do
            task.wait(0.15)
            pcall(function()
                local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                local target = GetClosestPlayerHRP()
                if not hrp or not target then return end
                local dist = (target.Position - hrp.Position).Magnitude
                if dist <= Config.TpPlayerRange then
                    local y = Config.TpAbovePlayer and Config.TpPlayerHeight or 0
                    hrp.CFrame = CFrame.new(target.Position + Vector3.new(0,y,0))
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
            end)
        end
        TpPlayerConn = nil
    end)
end
local function StopTpToPlayer() Config.TpToPlayer=false; if TpPlayerConn then task.cancel(TpPlayerConn) TpPlayerConn=nil end end

