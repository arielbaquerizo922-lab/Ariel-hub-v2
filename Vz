local CONFIG_FILE = "MichelleHub_Config.json"
local function Notify(title, content, duration)
    if not Config.Notifications then return end
    pcall(function() WindUI:Notify({ Title = title or "Michelle Hub", Content = content or "", Duration = duration or 2 }) end)
end
local function SaveConfig()
    if not writefile then return false end
    local ok = pcall(function()
        local data = {}
        for k, v in pairs(Config) do if type(v)=="boolean" or type(v)=="number" or type(v)=="string" then data[k]=v end end
        writefile(CONFIG_FILE, game:GetService("HttpService"):JSONEncode(data))
    end)
    return ok==true
end
local function LoadConfig()
    pcall(function()
        if isfile and readfile and isfile(CONFIG_FILE) then
            local data = game:GetService("HttpService"):JSONDecode(readfile(CONFIG_FILE))
            for k,v in pairs(data) do if Config[k]~=nil then Config[k]=v end end
        end
    end)
end
