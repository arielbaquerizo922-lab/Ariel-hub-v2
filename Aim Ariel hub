function Movement.StartAirJumpLoop()
    if Movement.AirJumpConnection then return end
    Movement.AirJumpConnection = UIS.JumpRequest:Connect(function()
        if Movement.InfiniteAirJump or Movement.HoldInfiniteAirJump then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)
end

function Movement.StopAirJumpLoop()
    if Movement.AirJumpConnection then
        Movement.AirJumpConnection:Disconnect()
        Movement.AirJumpConnection = nil
    end
end

function Movement.ApplySpeedBoost(deltaTime)
    if not Movement.SpeedBoost then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local moveDir = hum.MoveDirection
    if moveDir.Magnitude > 0.01 then
        local factor = math.clamp(Movement.SpeedValue, 1.0, 5.0)
        local dt = math.clamp(deltaTime or 0.016, 0.005, 0.05)
        hrp.CFrame = hrp.CFrame + (moveDir * factor * 25 * dt)
    end
end

function Movement.ExecuteSuperJump()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local power = Movement.SuperJumpPower
    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, power, hrp.AssemblyLinearVelocity.Z)
end

function Movement.ToggleWalkOnWater(enabled)
    Movement.WalkOnWater = enabled
    if enabled then
        if not Movement.WaterPlatform then
            local part = Instance.new("Part")
            part.Name = "AH_WaterPlatform"
            part.Size = Vector3.new(120, 2, 120)
            part.Anchored = true
            part.Transparency = 1
            part.CanCollide = true
            part.Position = Vector3.new(0, 0, 0)
