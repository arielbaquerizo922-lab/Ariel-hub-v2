local function StartFollowingPlayer()
    followPlayerTarget = GetClosestPlayer()
    if not followPlayerTarget then
        followPlayerActive = false
        if followPlayerButton then
            followPlayerButton.Text = "Seg Jug"
            followPlayerButton.TextColor3 = Color3.fromRGB(255,50,50)
            task.wait(1)
            followPlayerButton.TextColor3 = Color3.fromRGB(255,255,255)
        end
        return
    end
    if followPlayerButton then
        followPlayerButton.Text = "Seg Jug"
        followPlayerButton.TextColor3 = Color3.fromRGB(0,255,120)
    end
    followPlayerThread = coroutine.create(function()
        while followPlayerActive do
            local myChar = lp.Character
            local targetChar = followPlayerTarget and followPlayerTarget.Character
            if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then
                task.wait(CHANGE_INTERVAL)
                continue
            end
            if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") or not targetChar:FindFirstChild("Humanoid") or targetChar.Humanoid.Health <= 0 then
                followPlayerTarget = GetClosestPlayer()
                if not followPlayerTarget then StopFollowingPlayer() break end
                targetChar = followPlayerTarget.Character
                if not targetChar then task.wait(CHANGE_INTERVAL) continue end
            end
            local myHRP = myChar.HumanoidRootPart
            local targetHRP = targetChar.HumanoidRootPart
            local direccion = (targetHRP.Position - myHRP.Position).Unit
            local distancia = (targetHRP.Position - myHRP.Position).Magnitude
            if distancia > DISTANCE then
                myHRP.Velocity = direccion * followSpeed
            else
                myHRP.Velocity = Vector3.new(0, myHRP.Velocity.Y, 0)
            end
            task.wait(CHANGE_INTERVAL)
        end
    end)
    coroutine.resume(followPlayerThread)
end

