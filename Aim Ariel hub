local function DGI()
    pcall(function()
        -- Obtener SGE y V2 si aún no están disponibles
        if not SGE then
            local netFolder = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
            if netFolder then SGE = netFolder:FindFirstChild("RE/ShootGunEvent") end
        end
        if not V2 then
            local rem = ReplicatedStorage:FindFirstChild("Remotes")
            if rem then V2 = rem:FindFirstChild("Validator2") end
        end
        -- Obtener ShootFunction para el validador de código
        local success, module = pcall(require, ReplicatedStorage:WaitForChild("Controllers", 5):WaitForChild("CombatController", 5))
        if success and type(module) == "table" and module.Attack then
            SF = upv(module.Attack, 9)
        end
    end)
end

local function NV()
    if not SF then DGI() end
    if not SF then 
        return 0, 0 
    end
    local uv = getupvs(SF) or {}
    if uv[DV.v21] ~= 727595 then
        for i, v in pairs(uv) do
            if v == 727595 then
                local o = i - 15
                DV.v21 = i; DV.v22 = 13+o; DV.v23 = 16+o
                DV.v24 = 17+o; DV.v25 = 14+o; DV.v26 = 12+o; DV.v27 = 18+o
                break
            end
        end
    end
    local v1 = upv(SF, DV.v21)
    local v2 = upv(SF, DV.v22)
    local v3 = upv(SF, DV.v23)
    local v4 = upv(SF, DV.v24)
    local v5 = upv(SF, DV.v25)
    local v6 = upv(SF, DV.v26)
    local v7 = upv(SF, DV.v27)
    if not (v1 and v2 and v3 and v4 and v5 and v6 and v7) then return 0, 0 end
    -- Fórmula correcta (verificada contra el juego)
    local v8 = v6 * v2
    local v9 = (v5 * v2 + v6 * v1) % v3
    v9 = (v9 * v3 + v8) % v4
    v5 = math.floor(v9 / v3)
    v6 = v9 - v5 * v3
    v7 = v7 + 1
    setupv(SF, DV.v25, v5)
    setupv(SF, DV.v26, v6)
    setupv(SF, DV.v27, v7)
    return math.floor(v9 / v4 * 16777215), v7
end

local function DGT()
    local c = lp.Character
    local r = c and c:FindFirstChild'HumanoidRootPart'
    if not r then return end
    local cl, d = nil, DGd
    local rp = r.Position
    if DGm then
        local E = workspace:FindFirstChild'Enemies'
        if E then
            for _, e in next, E:GetChildren() do
                local hr = e:FindFirstChild'HumanoidRootPart' or e.PrimaryPart
                local h = e:FindFirstChildOfClass'Humanoid'
                if hr and h and h.Health > 0 then
                    local dx = (hr.Position - rp).Magnitude
                    if dx < d then d = dx; cl = hr end
                end
            end
        end
    end
    if DGp then
        for _, pl in next, P:GetPlayers() do
            if pl ~= lp and pl.Character then
                local hr = pl.Character:FindFirstChild'HumanoidRootPart'
                local h = pl.Character:FindFirstChildOfClass'Humanoid'
                if hr and h and h.Health > 0 then
                    local dx = (hr.Position - rp).Magnitude
                    if dx < d then d = dx; cl = hr end
                end
            end
        end
    end
    if DGs then
        for _, f in next, {workspace:FindFirstChild'SeaBeasts', workspace:FindFirstChild'SeaEvents'} do
            if f then
                for _, m in next, f:GetChildren() do
                    local hr = m:FindFirstChild'HumanoidRootPart' or m.PrimaryPart
                    if hr then
                        local dx = (hr.Position - rp).Magnitude
                        if dx < d then d = dx; cl = hr end
                    end
                end
            end
        end
    end
    return cl
end

local function GetClosestNPC()
    local closest = nil
    local shortestDistance = math.huge
    local myChar = lp.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, npc in pairs(enemies:GetChildren()) do
            local hum = npc:FindFirstChild("Humanoid")
            local hrp = npc:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local dist = (hrp.Position - myPos).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closest = npc
                end
            end
        end
    end
    return closest
end

local function GetClosestPlayer()
    local closest = nil
    local shortestDistance = math.huge
    local myChar = lp.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position
    for _, p in pairs(P:GetPlayers()) do
        if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            local hum = p.Character.Humanoid
            if hum.Health > 0 then
                local dist = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closest = p
                end
            end
        end
    end
    return closest
end

